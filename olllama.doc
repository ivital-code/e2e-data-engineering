```python
from coinbase_pro.client import Client

# Replace these with your actual API key and secret
api_key = 'YOUR_API_KEY'
api_secret = 'YOUR_API_SECRET'
passphrase = 'YOUR_PASSPHRASE'

# Initialize the client
client = Client(api_key, api_secret, passphrase)

# Get account information
accounts = client.get_accounts()

# Print the account information
for account in accounts:
    print(f"Account ID: {account.id}")
    print(f"Currency: {account.currency}")
    print(f"Balance: {account.balance}")
    print(f"Hold Balance: {account.hold}")
    print(f"Available Balance: {account.available}")
    print(f"Pending Balance: {account.pending}")
    print("-" * 40)
```

